<Application x:Class="Pomodorino.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="Ink" Color="#403A5A"/>
    <SolidColorBrush x:Key="Rose" Color="#E98FA3"/>
    <SolidColorBrush x:Key="Lavender" Color="#DCCEF6"/>
    <Style TargetType="Button"><Setter Property="Margin" Value="6"/><Setter Property="Padding" Value="16,9"/><Setter Property="FontSize" Value="16"/><Setter Property="Foreground" Value="{StaticResource Ink}"/></Style>
  </Application.Resources>
</Application>
